{# Implements: portable-template/a-fresh-copy-ships-its-planned-file-layout #}
{# Implements: portable-template/a-fresh-copy-declares-where-each-kind-of-document-lives #}
# The planned file layout: every file under src/{{ package_name }}/ is a row here, and the edit hook refuses a file
# that has none. A plan adds rows for its new or changed files in the same commit as its OpenSpec change; then
# `uv run lockstep layout` creates them with their requirement text. See AGENTS.md.
schema: lockstep.side.v1
# ship's planning gates, read from the default branch: block, warn or off (absent means warn since 2026-11-25).
planning:
  gate: warn
  one_page_plans: warn
# `lockstep check project` writes generated/wiki/ (one page per capability: requirements, implementing code, tests) and
# `--check` fails when it is stale.
generated_wiki: true
# Each kind of document has one home (wiki_methodology concern roots). `lockstep check` (the whole-tree check `make check` runs) reports a Markdown file
# outside every home, and the edit hook names the homes when an agent writes one elsewhere. README.md, AGENTS.md,
# CLAUDE.md, hidden folders and tests/ are not documents for this rule.
document_homes:
  docs/index.md: "The reading order: the front page of the documentation"
  docs/GOAL.md: "What this repository is for"
  docs/architecture/: "Design: what the system should be (arc42 and the diagram)"
  docs/decisions/: "Decision records: one accepted choice each, with its reason"
  docs/reference/: "The API reference page the documentation site builds from the docstrings"
  docs/specs/: "Generated: the documentation site's copy of openspec/specs (make docs-specs); never edit"
  openspec/: "Requirements (openspec/specs/) and change proposals (openspec/changes/)"
  research/: "Research: sources, investigations and findings; not a requirement until a change adopts it"
  evidence/: "Retained observations: what a run or check showed, at which commit"
  generated/: "Generator output, rebuilt from its inputs; never edit"
governed: [src/{{ package_name }}/]
fixed: ["src/{{ package_name }}/*"]
layout:
- path: src/{{ package_name }}/__init__.py
  purpose: The package; its docstring says what {{ project_name }} does
  implements: []
  tests: []
- path: src/{{ package_name }}/core.py
  purpose: The starter capability; replace it with the first real one
  implements:
  - core/reports-its-version
  tests:
  - tests/test_core.py
  exports:
  - "version() -> str"
- path: src/{{ package_name }}/cli.py
  purpose: The command line
  implements: []
  tests: []
  exports:
  - "main() -> int"
