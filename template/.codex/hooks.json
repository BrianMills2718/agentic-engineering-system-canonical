{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet lockstep-hook --client codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
