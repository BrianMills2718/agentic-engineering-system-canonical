[Unit]
Description=Daily feedback labels: sort each feedback issue into a failure-mode family, hand unmatched ones to an agent
After=feedback-collector.service
Documentation=https://github.com/BrianMills2718/agentic-engineering-system-canonical/blob/main/scripts/learning_loop/systemd/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/.hive-brain/aes
# These clones are reset from main every run, so a git lock older than an hour is from a run
# that died, never live work (a stale one stopped the collector for 9 days, 2026-10-17..26).
ExecStartPre=/usr/bin/find %h/.hive-brain/aes/.git %h/.hive-brain/project-meta/.git -maxdepth 1 -name index.lock -mmin +60 -delete
ExecStartPre=/usr/bin/flock %h/.hive-brain/aes/.git/runtime-update.lock /usr/bin/git -C %h/.hive-brain/aes fetch --quiet --depth 1 origin main
ExecStartPre=/usr/bin/flock %h/.hive-brain/aes/.git/runtime-update.lock /usr/bin/git -C %h/.hive-brain/aes reset --quiet --hard FETCH_HEAD
ExecStartPre=/usr/bin/flock %h/.hive-brain/project-meta/.git/runtime-update.lock /usr/bin/git -C %h/.hive-brain/project-meta fetch --quiet --depth 1 origin main
ExecStartPre=/usr/bin/flock %h/.hive-brain/project-meta/.git/runtime-update.lock /usr/bin/git -C %h/.hive-brain/project-meta reset --quiet --hard FETCH_HEAD
Environment=PROJECT_META=%h/.hive-brain/project-meta
ExecStart=/bin/bash -c 'mkdir -p %h/projects/data/feedback-collector && /usr/bin/python3 %h/.hive-brain/aes/scripts/learning_loop/label_items.py issues --other-concern-repo BrianMills2718/agent-skills >> %h/projects/data/feedback-collector/labels-$(date +%%F).log 2>&1'
TimeoutStartSec=2h
Nice=10
