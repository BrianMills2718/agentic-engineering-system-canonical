      },
      {
        "item_id": "OV-EVAL-IRREDUCIBLE-UNCERTAINTY",
        "statement": "The plan names the irreducibly empirical uncertainty the comparison resolves and explains why first principles and existing evidence or prior art cannot resolve it.",
        "effect": "blocking",
        "applicability": {
