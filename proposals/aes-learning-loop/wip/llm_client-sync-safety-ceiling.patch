+def test_sync_timeout_ban_bounds_a_provider_attempt_that_never_returns(
+    mock_comp: MagicMock,
+    _mock_supports_schema: MagicMock,
+    _mock_cost: MagicMock,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A provider that keeps the connection open forever ends at the safety ceiling.
+
+    The HTTP read timeout alone does not bound wall-clock time (keep-alive bytes reset it),
+    so the async path wraps each attempt in a process-side ceiling; the sync path must too.
+    Observed 2026-10-08: an OpenRouter call stayed open 15+ minutes under policy=ban.
+    """
+
+    monkeypatch.setenv("LLM_CLIENT_TIMEOUT_POLICY", "ban")
+    monkeypatch.setenv("LLM_CLIENT_SAFETY_TIMEOUT", "1")
+    released = __import__("threading").Event()
+    mock_comp.side_effect = lambda **_kw: released.wait(30)
+
+    started = time.monotonic()
+    try:
+        with pytest.raises(LLMError, match="safety deadline"):
+            _call_llm_structured_impl(
+                "gpt-4",
+                [{"role": "user", "content": "Name a city"}],
+                _City,
+                num_retries=0,
+                task="test",
+                trace_id="structured.runtime.sync.timeout-ban.hung-provider",
+                max_budget=0,
+            )
+    finally:
+        released.set()
+    assert time.monotonic() - started < 10
+
+
+def test_sync_deadline_without_ceiling_waits_for_the_attempt(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A zero safety ceiling explicitly delegates liveness to the caller (same as async)."""
+
+    monkeypatch.setenv("LLM_CLIENT_SAFETY_TIMEOUT", "0")
