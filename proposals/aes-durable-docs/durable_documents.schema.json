{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aes-durable-documents/0.1",
  "title": "durable_documents block of .agentic/repo.yaml (AES extension)",
  "description": "Declares where a governed repository keeps each durable document role. Each role is a repository-relative path, or {not_applicable: <reason>}. Plan aes-durable-docs, requirement R1.",
  "type": "object",
  "required": ["schema_version", "goal", "requirements", "system_model", "decisions", "plans"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "goal": {"$ref": "#/$defs/role"},
    "requirements": {"$ref": "#/$defs/role"},
    "system_model": {
      "oneOf": [
        {
          "type": "object",
          "required": ["prose", "trace"],
          "additionalProperties": false,
          "properties": {
            "prose": {"$ref": "#/$defs/path"},
            "trace": {"$ref": "#/$defs/path"}
          }
        },
        {"$ref": "#/$defs/not_applicable"}
      ]
    },
    "decisions": {"$ref": "#/$defs/role"},
    "glossary": {
      "oneOf": [
        {"type": "object", "required": ["generated"], "additionalProperties": false, "properties": {"generated": {"$ref": "#/$defs/path"}}},
        {"$ref": "#/$defs/not_applicable"}
      ]
    },
    "plans": {"$ref": "#/$defs/role"}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^[^/~][^\\0]*$"},
    "not_applicable": {
      "type": "object",
      "required": ["not_applicable"],
      "additionalProperties": false,
      "properties": {"not_applicable": {"type": "string", "minLength": 12}}
    },
    "role": {"oneOf": [{"$ref": "#/$defs/path"}, {"$ref": "#/$defs/not_applicable"}]}
  }
}
