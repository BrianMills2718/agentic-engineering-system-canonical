      {
        "item_id": "OV-CONTRACTS-SCHEMAS",
        "statement": "For each system boundary the plan crosses, it names every schema or contract the crossing uses or changes, with its owner and its file or URL, and says whether this plan changes it.",
        "effect": "blocking",
