{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aes.local/proposals/system-record.v0.schema.json",
  "title": "AES Candidate System Normative Record v0",
  "description": "Non-normative candidate schema for authored system-level target authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_kind","id","title","summary","outcomes","requirements","capabilities","failure_modes","component_refs"],
  "properties": {
    "schema_version": {"const": "aes.system_record.candidate.v0"},
    "record_kind": {"const": "system"},
    "id": {"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
    "title": {"type":"string","minLength":1},
    "summary": {"type":"string","minLength":1},
    "outcomes": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["id","statement"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "statement":{"type":"string","minLength":1}
      }}
    },
    "requirements": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["id","kind","statement","success_criteria"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "kind":{"enum":["behavior","constraint","invariant","quality","policy"]},
        "statement":{"type":"string","minLength":1},
        "rationale":{"type":"string","minLength":1},
        "success_criteria":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["id","statement","proof_requirements","disproof"],"properties":{
            "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
            "statement":{"type":"string","minLength":1},
            "proof_requirements":{"type":"array","minItems":1,"items":{
              "type":"object","additionalProperties":false,"required":["kind","statement"],"properties":{
                "kind":{"enum":["deterministic_test","human_review","llm_rubric","runtime_observation","static_analysis","contract_validation","external_consumer_observation","other"]},
                "statement":{"type":"string","minLength":1}
              }
            }},
            "disproof":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
          }
        }}
      }}
    },
    "capabilities": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["id","statement","requirement_refs","dependencies"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "statement":{"type":"string","minLength":1},
        "summary":{"type":"string","minLength":1},
        "requirement_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"}},
        "dependencies":{"type":"array","items":{
          "type":"object","additionalProperties":false,"required":["type","target","rationale","gate"],"properties":{
            "type":{"enum":["hard","evidence","operational","sequencing","optional"]},
            "target":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
            "rationale":{"type":"string","minLength":1},
            "gate":{"type":"string","minLength":1}
          }
        }}
      }}
    },
    "failure_modes": {
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["id","statement","consequence","responses"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "statement":{"type":"string","minLength":1},
        "consequence":{"type":"string","minLength":1},
        "responses":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["role"],"properties":{
            "role":{"enum":["prevent","detect","contain","recover"]},
            "capability_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"}},
            "requirement_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"}},
            "criterion_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"}},
            "statement":{"type":"string","minLength":1}
          },
          "anyOf":[{"required":["capability_refs"]},{"required":["requirement_refs"]},{"required":["criterion_refs"]}]
        }}
      }}
    },
    "component_refs": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["id","path","summary"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "path":{"type":"string","minLength":1,"not":{"pattern":"(^/|(^|/)\\.\\.(/|$))"}},
        "summary":{"type":"string","minLength":1}
      }}
    },
    "questions": {
      "type":"array",
      "items":{"type":"object","additionalProperties":false,"required":["id","question","status"],"properties":{
        "id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},
        "question":{"type":"string","minLength":1},
        "status":{"enum":["open","researched","resolved","deferred"]},
        "decision_ref":{"type":"string","minLength":1,"not":{"pattern":"(^/|(^|/)\\.\\.(/|$))"}}
      },
      "allOf":[{"if":{"properties":{"status":{"const":"resolved"}}},"then":{"required":["decision_ref"]}}]
      }
    },
    "decision_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"not":{"pattern":"(^/|(^|/)\\.\\.(/|$))"}}}
  }
}
