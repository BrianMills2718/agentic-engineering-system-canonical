{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aes.local/proposals/engineering-event.v0.schema.json","title":"AES Candidate Append-only Engineering Event v0","description":"Semantic event/receipt referencing authoritative payloads rather than duplicating mutable truth.","type":"object","additionalProperties":false,"required":["schema_version","record_kind","event_id","event_kind","occurred_at","subject_refs","source_revision","payload_refs","summary"],"properties":{"schema_version":{"const":"aes.engineering_event.candidate.v0"},"record_kind":{"const":"engineering_event"},"event_id":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"},"event_kind":{"enum":["normative_change_accepted","topology_change_accepted","decision_accepted","decision_superseded","implementation_observed","verification_observed","evidence_invalidated","human_disposition","model_disposition","projection_generated"]},"occurred_at":{"type":"string","format":"date-time"},"subject_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"source_revision":{"type":"string","minLength":1},"payload_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["path","digest"],"properties":{"path":{"type":"string","minLength":1,"not":{"pattern":"(^/|(^|/)\\.\\.(/|$))"}},"digest":{"type":"string","pattern":"^(sha256:)?[0-9a-f]{64}$"}}}},"summary":{"type":"string","minLength":1},"supersedes_event_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9._:-]*$"}}}}
