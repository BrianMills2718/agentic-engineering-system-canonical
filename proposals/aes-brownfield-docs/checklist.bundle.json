  "coverage": "complete",
  "definition": {
    "schema_version": "checklist-definition.v1",
    "record_type": "checklist_definition",
    "checklist_id": "method-conformance.bounded-design",
    "revision": "sha256:3cc6773559404c7ae12294666a23b6ec49ef03b819a47eda2495fe5b09c51bb8",
    "title": "bounded-design method conformance for PLAN",
    "purpose": "Route-bound evidence that the selected Company Planning method was applied before adoption.",
    "subject_ref": {
      "kind": "planning_review",
      "id": "PLAN",
      "revision": "sha256:504cad2cd11e6267bb402dac2de2aafedca391977b5f1ad3d32fc11f582f978c"
    },
    "items": [
      {
        "item_id": "CORE-ACTOR-RESULT-EXAMPLE",
        "statement": "The plan names the actor it serves, the desired result, and one stable, concrete, user-visible example of that result.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/docs/designs/enforcement/PLANNING_METHOD_CONFORMANCE_RECEIPT.md",
          "revision": "0a6587e616d2d596d278c28a352fdd8c0d6b19eb",
          "pointer": "#core-and-conditional-requirements"
        }
      },
      {
        "item_id": "CORE-ROUTE",
        "statement": "The selected Company Planning route equals the deterministic path classification of the recorded structural facts.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "path_decision_record"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/skills/bounded-design/SKILL.md",
          "revision": "288337d670d928c2604e32c2e073a866c0a897b4",
          "pointer": "#choose-the-route-before-adding-structure"
        }
      },
      {
        "item_id": "CORE-SUCCESS-DISPROOF",
        "statement": "The plan defines the evidence that would show success and a concrete condition that would disprove the approach.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/skills/bounded-design/SKILL.md",
          "revision": "288337d670d928c2604e32c2e073a866c0a897b4",
          "pointer": "#4-derive-the-design"
        }
      },
      {
        "item_id": "CORE-AUTHORITY-NONGOALS",
        "statement": "The plan states who holds authority over the work and what it explicitly will not do (non-goals).",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/docs/designs/enforcement/PLANNING_METHOD_CONFORMANCE_RECEIPT.md",
          "revision": "0a6587e616d2d596d278c28a352fdd8c0d6b19eb",
          "pointer": "#core-and-conditional-requirements"
        }
      },
      {
        "item_id": "CORE-IRREVERSIBLE-SPEND",
        "statement": "For each irreversible action or spend the plan proposes, it names the boundary, who must authorize it, and how it is contained.",
        "effect": "blocking",
        "applicability": {
          "mode": "conditional",
          "condition": "fact:irreversible_or_spend_action"
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/docs/designs/enforcement/PLANNING_METHOD_CONFORMANCE_RECEIPT.md",
          "revision": "0a6587e616d2d596d278c28a352fdd8c0d6b19eb",
          "pointer": "#core-and-conditional-requirements"
        }
      },
      {
        "item_id": "CORE-UNCERTAINTIES",
        "statement": "The plan lists its material uncertainties, and each one has an owner or the evidence that would resolve it.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/docs/designs/enforcement/PLANNING_METHOD_CONFORMANCE_RECEIPT.md",
          "revision": "0a6587e616d2d596d278c28a352fdd8c0d6b19eb",
          "pointer": "#core-and-conditional-requirements"
        }
      },
      {
        "item_id": "CORE-ACTIVATION-FACTS",
        "statement": "No activation fact that the plan triggers is declared false. Declaring a fact true when the plan does not strictly need it is acceptable, because it only adds checks; judge only facts declared false. empirical_comparison_proposed is triggered when the plan proposes an A/B test, benchmark, bake-off, or other experiment comparing alternative designs, models, or candidates to choose among them; checking the built result against an expected outcome (an acceptance test, fixture replay, or regression check) is verification and does not trigger it. shared_mechanism is triggered by a new shared mechanism, contract, or algorithm; llm_central by behavior that centrally depends on LLM calls; irreversible_or_spend_action by a proposed irreversible action or spend.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_document",
          "activation_facts_record"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/docs/designs/enforcement/PLANNING_METHOD_CONFORMANCE_RECEIPT.md",
          "revision": "0a6587e616d2d596d278c28a352fdd8c0d6b19eb",
          "pointer": "#core-and-conditional-requirements"
        }
      },
      {
        "item_id": "OV-PRIOR-ART-DISPOSITION",
        "statement": "Existing ownership, internal lineage, and relevant external prior art were searched, and each candidate found is dispositioned as reuse, extend, compose, supersede, or bounded exception.",
        "effect": "blocking",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/skills/bounded-design/SKILL.md",
          "revision": "288337d670d928c2604e32c2e073a866c0a897b4",
          "pointer": "#3-establish-current-truth"
        }
      },
      {
        "item_id": "OV-PRIOR-ART-PARALLEL-CHECK",
        "statement": "The plan names one concrete structural check or consumer-path observation that would detect a silent parallel implementation of the same concern.",
        "effect": "advisory",
        "applicability": {
          "mode": "required",
          "condition": null
        },
        "evidence_required": [
          "plan_section"
        ],
        "source_ref": {
          "repository": "BrianMills2718/company-planning",
          "path": "plugins/company-planning/skills/bounded-design/SKILL.md",
          "revision": "288337d670d928c2604e32c2e073a866c0a897b4",
          "pointer": "#3-establish-current-truth"
        }
      }
    ]
  },
