      "id": "runtime-trust",
      "status": "observed",
      "subject": "control",
      "statement": "Codex hooks/list at Project Meta reported 14 configured hooks, 8 trusted and 6 untrusted on 2026-10-06. Trust eligibility is distinct from an execution receipt.",
      "evidence": "verification/runtime-snapshot.json"
    },
    {
      "id": "lifecycle-cost",
      "status": "observed",
      "subject": "definitions",
      "statement": "The fresh registry census contains 125 active Measured or Enforced entries. One declares budget and retire_when; 124 omit both. This identifies incomplete lifecycle metadata, not the net value of the policies. The registry changed outside this model lane during the investigation.",
      "evidence": "verification/runtime-snapshot.json"
    },
