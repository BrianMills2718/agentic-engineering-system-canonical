    "client": {
     "default": "",
     "title": "Client",
     "type": "string"
    },
    "cwd": {
     "default": "",
     "title": "Cwd",
     "type": "string"
    },
    "line": {
     "default": "",
     "title": "Line",
     "type": "string"
    },
    "session_id": {
     "default": "",
     "title": "Session Id",
     "type": "string"
    },
    "ts": {
     "default": "",
     "title": "Ts",
     "type": "string"
    },
    "turn_offset": {
     "default": 0,
     "title": "Turn Offset",
     "type": "integer"
    }
   },
   "title": "Provenance",
   "type": "object"
  }
 },
 "properties": {
  "basis": {
