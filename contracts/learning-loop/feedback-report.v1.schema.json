   "type": "string"
  },
  "supports": {
   "items": {
    "type": "string"
   },
   "title": "Supports",
   "type": "array"
  },
  "text": {
   "title": "Text",
   "type": "string"
  },
  "unprovenanced": {
   "default": false,
   "title": "Unprovenanced",
   "type": "boolean"
  }
 },
 "required": [
  "kind",
  "text"
 ],
