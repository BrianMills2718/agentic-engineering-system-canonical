     "type": "string"
    },
    "ref": {
     "title": "Ref",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "ref"
   ],
   "title": "Link",
   "type": "object"
  },
  "Provenance": {
   "description": "Who filed it, when, and from where (the nanopublication-style pubinfo).",
