    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Basis"
  },
  "confidence": {
   "anyOf": [
    {
     "enum": [
      "low",
      "medium",
      "high"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Confidence"
  },
  "contract": {
   "default": "feedback-report.v1",
   "title": "Contract",
   "type": "string"
  },
  "evidence_word": {
   "default": "",
   "title": "Evidence Word",
   "type": "string"
  },
  "expected": {
   "default": "",
   "title": "Expected",
   "type": "string"
  },
  "id": {
   "default": "",
   "title": "Id",
   "type": "string"
  },
  "intent": {
   "anyOf": [
    {
     "enum": [
      "Investigate",
      "Mitigate",
      "Repair",
      "Detect",
      "Prevent"
     ],
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Intent"
  },
  "kind": {
   "enum": [
    "observation",
    "claim",
