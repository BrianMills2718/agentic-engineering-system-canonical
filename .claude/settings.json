{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from git+https://github.com/BrianMills2718/agentic-engineering-system-canonical@09414e9b4cedc5954f81395e0d7a64710e635912 lockstep refresh --client claude",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "disableAllHooks": false
}
